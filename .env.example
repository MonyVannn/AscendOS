# Convex
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk — https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# App Router paths — must align with Clerk Dashboard "Paths"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# After OAuth/sign-in completes, prefer landing on / so hub applies role/agency routing
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# GHL Proxy API
# GHL Inbound Webhook URL is stored per-agency in Convex (agencies.ghlWebhookUrl)
GHL_REQUEST_TIMEOUT_MS=5000
GHL_RETRY_DELAY_MS=1000
